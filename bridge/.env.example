# -----------------------------------------------
# EcoMemories Bridge — Environment Configuration
# -----------------------------------------------
# Copy this file to .env and fill in your values.
# cp .env.example .env

# Serial port the Arduino is connected to.
# Windows example: COM3
# macOS example:   /dev/tty.usbmodem14101
# Linux example:   /dev/ttyUSB0
SERIAL_PORT=COM3

# Arduino baud rate — must match Serial.begin() in your sketch.
BAUD_RATE=9600

# Full base URL of your Laravel app (no trailing slash).
# Local:   http://localhost:8000
# Tunnel:  https://yourapp.trycloudflare.com
LARAVEL_URL=http://localhost:8000

# Device identifier sent with every deposit event.
# Must match a device_code registered in the devices table.
DEVICE_ID=ARDUINO-001

# Optional shared secret — must match DEVICE_SECRET in Laravel .env.
# Leave blank to disable header-based auth during development.
DEVICE_SECRET=

# Port the bridge HTTP server listens on.
# The React kiosk will POST /session to this port.
BRIDGE_PORT=3333
